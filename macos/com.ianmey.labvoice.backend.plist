<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ianmey.labvoice.backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/private/tmp/labvoice-backend-venv312/bin/python</string>
    <string>-S</string>
    <string>/private/tmp/labvoice-backend-runtime/run_backend.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/private/tmp/labvoice-backend-runtime</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OSVOZ_ENV_FILE</key>
    <string>/private/tmp/labvoice-backend.env</string>
    <key>OSVOZ_SESSION_DATABASE</key>
    <string>/private/tmp/labvoice-session.db</string>
    <key>OSVOZ_AUDIT_DATABASE</key>
    <string>/private/tmp/labvoice-audit.db</string>
    <key>OSVOZ_NATIVE_CORE_PATH</key>
    <string>/private/tmp/labvoice-backend-runtime/bin/labvoice-native-core</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <key>StandardOutPath</key>
  <string>/private/tmp/labvoice-backend.log</string>
  <key>StandardErrorPath</key>
  <string>/private/tmp/labvoice-backend.log</string>
</dict>
</plist>
