{
  "name": "labvoice-vscode-bridge",
  "displayName": "OSvoz VS Code Bridge",
  "description": "Connects the active VS Code workspace to OSvoz.",
  "version": "0.1.0",
  "publisher": "ianmey",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "labvoice.connect",
        "title": "OSvoz: Connect to Current Workspace"
      },
      {
        "command": "labvoice.syncContext",
        "title": "OSvoz: Synchronize Editor Context"
      },
      {
        "command": "labvoice.describeContext",
        "title": "OSvoz: Describe Current Context"
      },
      {
        "command": "labvoice.undoLastEdit",
        "title": "OSvoz: Undo Last Applied Edit"
      }
    ],
    "configuration": {
      "title": "OSvoz",
      "properties": {
        "labvoice.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Local OSvoz backend URL."
        },
        "labvoice.maxWorkspaceFiles": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 5000,
          "description": "Maximum number of workspace paths shared with OSvoz."
        }
      }
    }
  }
}
